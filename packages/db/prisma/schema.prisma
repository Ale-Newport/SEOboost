enum JobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
  DELAYED
}

/// Durable mirror of queue jobs so the Jobs UI works even when Redis is unavailable.
model JobRecord {
  id        String @id @default(cuid())
  websiteId String?

  queue     String
  jobName   String
  jobId     String?  @unique
  status    JobStatus @default(QUEUED)
  progress  Int       @default(0)
  progressMessage String?
  payload   Json      @default("{}")
  result    Json?     @default("{}")
  error     String?
  attempts  Int       @default(0)
  maxAttempts Int     @default(3)
  startedAt DateTime?
  finishedAt DateTime?
  durationMs Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  website Website? @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([websiteId, createdAt])
  @@index([status, createdAt])
  @@index([queue, status])
}

model ScheduledJob {
  id        String @id @default(cuid())
  websiteId String?

  name      String
  queue     String
  jobName   String
  cron      String
  payload   Json    @default("{}")
  isEnabled Boolean @default(true)
  lastRunAt DateTime?
  nextRunAt DateTime?
  lastStatus String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  website Website? @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@unique([websiteId, name])
  @@index([isEnabled])
}

// ─────────────────────────────────────────────────────────────
// Reporting & notifications
// ─────────────────────────────────────────────────────────────

model Report {
  id        String @id @default(cuid())
  websiteId String?

  type       String
  title      String
  periodStart DateTime
  periodEnd   DateTime
  data       Json    @default("{}")
  summary    String?
  highlights Json    @default("[]")
  createdAt  DateTime @default(now())

  website Website? @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([websiteId, type, periodEnd])
}

enum NotificationSeverity {
  INFO
  SUCCESS
  WARNING
  CRITICAL
}

model Notification {
  id        String  @id @default(cuid())
  websiteId String?
  userId    String?

  type      String
  severity  NotificationSeverity @default(INFO)
  title     String
  message   String
  link      String?
  data      Json    @default("{}")
  isRead    Boolean @default(false)
  readAt    DateTime?
  /// Deduplication key so repeated detections do not spam the inbox.
  dedupeKey String?

  createdAt DateTime @default(now())

  website Website? @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  user    User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([dedupeKey])
  @@index([userId, isRead, createdAt])
  @@index([websiteId, createdAt])
}

/// Daily roll-up of site-level scores; powers the score history charts.
model ScoreSnapshot {
  id        String   @id @default(cuid())
  websiteId String
  date      DateTime @db.Date

  healthScore       Float?
  geoScore          Float?
  aiVisibilityScore Float?
  contentScore      Float?
  openIssues        Int    @default(0)
  criticalIssues    Int    @default(0)
  indexablePages    Int    @default(0)
  orphanPages       Int    @default(0)
  keywordsTop3      Int    @default(0)
  keywordsTop10     Int    @default(0)
  keywordsTop100    Int    @default(0)
  clicks28d         Int    @default(0)
  impressions28d    Int    @default(0)
  avgPosition       Float?

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@unique([websiteId, date])
  @@index([websiteId, date])
}

/// The AI SEO Manager's plan for a site (today / this week / this month).
model StrategyPlan {
  id        String @id @default(cuid())
  websiteId String

  periodLabel String
  situation   String
  biggestProblems Json @default("[]")
  biggestOpportunities Json @default("[]")
  strategy    String
  today       Json @default("[]")
  thisWeek    Json @default("[]")
  thisMonth   Json @default("[]")
  observedResults Json @default("[]")
  confidence  Float @default(0.6)
  agentRunId  String?
  isCurrent   Boolean @default(true)

  createdAt DateTime @default(now())

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([websiteId, createdAt])
}

// ─────────────────────────────────────────────────────────────
// Embeddings
// ─────────────────────────────────────────────────────────────

enum EmbeddingOwner {
  PAGE
  KEYWORD
  CLUSTER
  ENTITY
  DRAFT
}

model EmbeddingRecord {
  id        String @id @default(cuid())
  websiteId String

  ownerType EmbeddingOwner
  pageId    String? @unique
  keywordId String? @unique
  ownerId   String

  model     String
  dimensions Int
  vector    Float[]
  textHash  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  page    Page?    @relation(fields: [pageId], references: [id], onDelete: Cascade)
  keyword Keyword? @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  @@unique([ownerType, ownerId])
  @@index([websiteId, ownerType])
}

// ─────────────────────────────────────────────────────────────
// Global app settings (single-row-ish key/value)
// ─────────────────────────────────────────────────────────────

model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
