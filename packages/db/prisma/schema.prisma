// ─────────────────────────────────────────────────────────────

enum ActionType {
  FIX_TECHNICAL_ISSUE
  UPDATE_TITLE
  UPDATE_META_DESCRIPTION
  UPDATE_CONTENT
  PUBLISH_CONTENT
  CREATE_CONTENT_BRIEF
  ADD_INTERNAL_LINKS
  ADD_STRUCTURED_DATA
  CREATE_REDIRECT
  REFRESH_CONTENT
  CONSOLIDATE_PAGES
  SUBMIT_URL_INDEXING
  GEO_IMPROVEMENT
  OUTREACH_DRAFT
  CUSTOM
}

enum ActionRisk {
  SAFE
  MEDIUM
  HIGH
}

enum ActionStatus {
  PROPOSED
  QUEUED
  AWAITING_APPROVAL
  APPROVED
  REJECTED
  EXECUTING
  COMPLETED
  FAILED
  ROLLED_BACK
  CANCELLED
  MEASURING
  EVALUATED
}

model SeoAction {
  id        String @id @default(cuid())
  websiteId String

  type    ActionType
  title   String
  status  ActionStatus @default(PROPOSED)
  risk    ActionRisk   @default(SAFE)

  reasoning      String
  evidence       Json    @default("{}")
  affectedUrls   String[] @default([])
  requiredAgent  String?
  payload        Json     @default("{}")

  impactScore     Float @default(0)
  effortScore     Float @default(1)
  confidenceScore Float @default(0.5)
  businessValue   Float @default(0.5)
  riskScore       Float @default(1)
  priorityScore   Float @default(0)
  priorityFactors Json  @default("{}")

  sourceType String?
  sourceId   String?
  autoExecutable Boolean @default(false)

  proposedAt  DateTime  @default(now())
  approvedAt  DateTime?
  executedAt  DateTime?
  completedAt DateTime?
  measureAfter DateTime?
  error       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  website    Website           @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  executions ActionExecution[]
  approvals  Approval[]
  experiment Experiment?
  changeLogs ChangeLog[]

  @@index([websiteId, status, priorityScore])
  @@index([websiteId, type])
}

model ActionExecution {
  id       String @id @default(cuid())
  actionId String

  attempt    Int      @default(1)
  status     String   @default("RUNNING")
  adapter    String?
  request    Json?    @default("{}")
  response   Json?    @default("{}")
  beforeState Json?   @default("{}")
  afterState  Json?   @default("{}")
  rollbackData Json?  @default("{}")
  error      String?
  startedAt  DateTime @default(now())
  finishedAt DateTime?
  durationMs Int?

  action SeoAction @relation(fields: [actionId], references: [id], onDelete: Cascade)

  @@index([actionId])
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

model Approval {
  id        String @id @default(cuid())
  websiteId String
  actionId  String?
  userId    String?

  kind        String
  title       String
  description String?
  risk        ActionRisk @default(SAFE)
  status      ApprovalStatus @default(PENDING)
  diff        Json?      @default("{}")
  payload     Json       @default("{}")
  decidedAt   DateTime?
  decisionNote String?
  editedPayload Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  website Website    @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  action  SeoAction? @relation(fields: [actionId], references: [id], onDelete: Cascade)
  user    User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([websiteId, status])
  @@index([status, createdAt])
}

enum ExperimentStatus {
  RUNNING
  COMPLETED
  ABANDONED
}

enum ExperimentOutcome {
  PENDING
  LIKELY_POSITIVE
  INCONCLUSIVE
  LIKELY_NEGATIVE
}

model Experiment {
  id        String @id @default(cuid())
  websiteId String
  actionId  String? @unique
  pageId    String?

  name        String
  hypothesis  String?
  metric      String  @default("clicks")
  status      ExperimentStatus  @default(RUNNING)
  outcome     ExperimentOutcome @default(PENDING)

  changeSummary String?
  beforeState   Json  @default("{}")
  afterState    Json  @default("{}")

  baselineStart DateTime
  baselineEnd   DateTime
  measureStart  DateTime
  measureEnd    DateTime?
  minDays       Int      @default(28)

  baselineMetrics Json? @default("{}")
  resultMetrics   Json? @default("{}")
  deltaPct        Float?
  significance    Float?
  interpretation  String?
  evaluatedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  website Website    @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  action  SeoAction? @relation(fields: [actionId], references: [id], onDelete: Cascade)
  page    Page?      @relation(fields: [pageId], references: [id], onDelete: SetNull)

  @@index([websiteId, status])
}

/// Immutable audit trail of everything the platform changed.
model ChangeLog {
  id        String @id @default(cuid())
  websiteId String
  actionId  String?
  userId    String?

  actor       String
  agent       String?
  changeType  String
  targetUrl   String?
  summary     String
  beforeState Json?  @default("{}")
  afterState  Json?  @default("{}")
  reason      String?
  approved    Boolean @default(false)
  rollbackable Boolean @default(false)
  rolledBackAt DateTime?
  resultMetrics Json? @default("{}")

  createdAt DateTime @default(now())

  website Website    @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  action  SeoAction? @relation(fields: [actionId], references: [id], onDelete: SetNull)
  user    User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([websiteId, createdAt])
}

