  PUBLISHED
  REJECTED
}

enum ContentStageStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  SKIPPED
}

model ContentDraft {
  id        String @id @default(cuid())
  websiteId String
  briefId   String?
  pageId    String?

  kind        String  @default("NEW")
  title       String
  slug        String?
  metaTitle   String?
  metaDescription String?
  bodyMarkdown String  @default("")
  bodyHtml     String?
  excerpt      String?
  targetKeyword String?
  wordCount    Int     @default(0)

  stage       ContentStage @default(RESEARCH)
  currentStageStatus ContentStageStatus @default(PENDING)

  seoScore        Float?
  geoScore        Float?
  readabilityScore Float?
  qualityScore    Float?
  keywordCoverage Json?  @default("{}")
  qualityFlags    Json   @default("[]")
  unverifiedClaims Json  @default("[]")
  sources         Json   @default("[]")
  internalLinks   Json   @default("[]")
  structuredData  Json?
  scheduledFor    DateTime?
  publishedAt     DateTime?
