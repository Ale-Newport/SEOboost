  bodyMarkdown String
  metaTitle String?
  metaDescription String?
  authorType String @default("ai")
  authorName String?
  changeSummary String?
  createdAt DateTime @default(now())

  draft ContentDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@unique([draftId, version])
  @@index([draftId])
}

