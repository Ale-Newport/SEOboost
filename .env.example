# ─────────────────────────────────────────────────────────────────────────────
# SEO OS — environment
#
# Only the three REQUIRED values below are needed to boot. Every integration is
# optional: unconfigured providers show as "Not configured" in Settings → Integrations
# and the rest of the platform keeps working.
# ─────────────────────────────────────────────────────────────────────────────

# ── REQUIRED ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://seo:seo@localhost:5432/seo_os?schema=public"
# 32+ random chars. Generate: openssl rand -base64 48
AUTH_SECRET=""
# 32-byte key, base64. Encrypts integration credentials at rest.
# Generate: openssl rand -base64 32
# WARNING: changing this makes existing stored credentials unreadable.
ENCRYPTION_KEY=""

# ── Strongly recommended ─────────────────────────────────────────────────────
# Without Redis the app still runs, but background jobs stay queued and no worker
# picks them up. Start Redis and run the worker to enable crawling, syncs and agents.
REDIS_URL="redis://localhost:6379"

APP_URL="http://localhost:3000"
NODE_ENV="development"
LOG_LEVEL="info"

# Set true only to explore the UI with clearly-labelled demo data (seeded rows are
# marked isDemo). Keep false for real websites.
DEMO_MODE="false"

# Allow creating the first account through the signup page. Set false after your
# account exists to lock down a single-user install.
ALLOW_SIGNUP="true"

# ── AI providers (at least one enables agents, briefs, GEO and AI visibility) ─
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GOOGLE_AI_API_KEY=""
# anthropic | openai | gemini — otherwise the first configured provider wins.
DEFAULT_AI_PROVIDER=""
# Hard monthly ceiling in USD across all sites. 0 = no global cap (per-site caps still apply).
AI_MONTHLY_BUDGET_USD="0"

# ── Google Search Console + GA4 (OAuth) ──────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web application).
# Authorised redirect URI must be exactly APP_URL + /api/integrations/google/callback
# Enable: "Google Search Console API" and "Google Analytics Data API".
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI=""

# ── Bing Webmaster Tools ─────────────────────────────────────────────────────
# Bing Webmaster Tools → Settings → API access → API key
BING_API_KEY=""

# ── SERP data (optional; the platform degrades to Search Console data without it) ──
DATAFORSEO_LOGIN=""
DATAFORSEO_PASSWORD=""
SERPAPI_KEY=""
SERPER_API_KEY=""

# ── Backlink providers (optional; CSV import always works without them) ──────
AHREFS_API_KEY=""
SEMRUSH_API_KEY=""
MOZ_ACCESS_ID=""
MOZ_SECRET_KEY=""

# ── Crawler ──────────────────────────────────────────────────────────────────
CRAWLER_USER_AGENT="SEO-OS-Bot/1.0 (+https://github.com/seo-os)"
CRAWLER_MAX_CONCURRENCY="6"
# Requires `npx playwright install chromium`. Off by default — HTTP crawling is much faster.
ENABLE_JS_RENDERING="false"
# Optional public URL used by the development smoke test. Never used in production.
SAMPLE_CRAWL_URL=""

# ── Social listening & publishing (optional) ─────────────────────────────────
# agent-reach (https://github.com/Panniantong/agent-reach) is a read-only CLI that lets the
# listening agent search Reddit, X, YouTube, GitHub, Instagram, Facebook and V2EX. Install it
# from its GitHub install.md (NOT the unrelated PyPI package named agent-reach). Without it,
# Reddit, Hacker News and Bluesky are still read through their own APIs.
AGENT_REACH_BIN="agent-reach"
AGENT_REACH_TIMEOUT_MS="90000"
# Comma-separated allow-list of agent-reach channels (e.g. "reddit,twitter,youtube"); empty = all.
AGENT_REACH_CHANNELS=""
# Reddit's API terms require a descriptive user agent. Defaults to one naming APP_URL.
SOCIAL_USER_AGENT=""
# Posting accounts (Reddit, Bluesky, Mastodon, X, LinkedIn, Dev.to, Telegram, Discord) are
# connected per site in the UI (Site → Social → Accounts) and stored encrypted — not here.
# One-time developer apps for one-click "Connect" (OAuth). Easiest is to paste them in the UI
# (Social → Accounts → One-time developer apps); these env vars are a fallback. Register each
# app with the redirect URI ${APP_URL}/api/social/oauth/<reddit|x|linkedin|discord>/callback.
# Mastodon needs nothing here: the app registers itself on each server.
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
X_CLIENT_ID=""
X_CLIENT_SECRET=""
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""


# ── Worker ───────────────────────────────────────────────────────────────────
WORKER_CONCURRENCY="4"
ENABLE_SCHEDULER="true"
